{
  "$defs": {
    "AssessmentDecision": {
      "enum": [
        "run",
        "skip"
      ],
      "title": "AssessmentDecision",
      "type": "string"
    },
    "AssessmentPayload": {
      "description": "One assessment as the log shows it: the decision, its reason and the sizes behind it.\n\nCounts rather than the id tuples the row holds, for the reason the prompt triple below states:\na fifty row page carrying every changed node id would fight the log's own cap. The whole\nobject stays on the run row, where the run detail reads it.",
      "properties": {
        "added_nodes": {
          "default": 0,
          "title": "Added Nodes",
          "type": "integer"
        },
        "affected_flow": {
          "default": 0,
          "title": "Affected Flow",
          "type": "integer"
        },
        "deferred_pairs": {
          "default": 0,
          "title": "Deferred Pairs",
          "type": "integer"
        },
        "facts_changed_nodes": {
          "default": 0,
          "title": "Facts Changed Nodes",
          "type": "integer"
        },
        "new_pairs": {
          "default": 0,
          "title": "New Pairs",
          "type": "integer"
        },
        "removed_nodes": {
          "default": 0,
          "title": "Removed Nodes",
          "type": "integer"
        },
        "resolved_pairs": {
          "default": 0,
          "title": "Resolved Pairs",
          "type": "integer"
        },
        "stale_refinements": {
          "default": 0,
          "title": "Stale Refinements",
          "type": "integer"
        },
        "verdict": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "verdict"
      ],
      "title": "AssessmentPayload",
      "type": "object"
    },
    "CallForm": {
      "description": "How a name was called at the site the resolver could not place: a bare ``name()``, a\ndirect ``self``/``cls`` receiver, or any other attribute receiver.",
      "enum": [
        "bare",
        "self",
        "attr"
      ],
      "title": "CallForm",
      "type": "string"
    },
    "ClientKind": {
      "enum": [
        "claude-code",
        "codex",
        "cli"
      ],
      "title": "ClientKind",
      "type": "string"
    },
    "Decision": {
      "description": "The gate's answer and the one line a human reads for it (spec 8.6).\n\nOne object rather than two fields prevents mixing decisions' reasons; neither field defaults, as empty verdicts are not answers.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/AssessmentDecision"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EdgeKind": {
      "enum": [
        "contains",
        "calls",
        "imports",
        "inherits",
        "overrides",
        "callback_arg",
        "registered_in",
        "references_type",
        "name_similar",
        "usage_similar"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "LogNarrowing": {
      "description": "A filter the caller set, named so an empty page can say which one emptied it.\n\nOnly the caller's own filters are here. The default runs view hides the assessment-only rows\non its own, and that hiding is reported by ``hidden_statuses`` instead.",
      "enum": [
        "status",
        "since"
      ],
      "title": "LogNarrowing",
      "type": "string"
    },
    "LogReport": {
      "description": "One page of the provenance log: one view, what produced it, and what it did not show.\n\nAn empty page has three causes and the fields separate them: ``narrowed_by`` is what the\ncaller filtered, ``hidden_statuses`` and ``hidden_count`` are what the default runs view hid\non its own, and neither set means nothing is recorded.",
      "properties": {
        "hidden_count": {
          "default": 0,
          "title": "Hidden Count",
          "type": "integer"
        },
        "hidden_statuses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunStatus"
          },
          "title": "Hidden Statuses",
          "type": "array"
        },
        "narrowed_by": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LogNarrowing"
          },
          "title": "Narrowed By",
          "type": "array"
        },
        "refinement_count": {
          "default": 0,
          "title": "Refinement Count",
          "type": "integer"
        },
        "refinements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RefinementRowPayload"
          },
          "title": "Refinements",
          "type": "array"
        },
        "run_count": {
          "default": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunRowPayload"
          },
          "title": "Runs",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "view": {
          "$ref": "#/$defs/LogView",
          "default": "runs"
        }
      },
      "title": "LogReport",
      "type": "object"
    },
    "LogView": {
      "description": "Which half of the provenance the log is showing.",
      "enum": [
        "runs",
        "refinements"
      ],
      "title": "LogView",
      "type": "string"
    },
    "ProducerKind": {
      "enum": [
        "observer",
        "agent",
        "cli"
      ],
      "title": "ProducerKind",
      "type": "string"
    },
    "RefinementCounts": {
      "description": "How many refinements one run owns, split by fate (spec 9.2 stores every rejection).\n\nOne shape for every surface: the run log's column, `graph_refine_status` and the summary a\nfinished run records all read it, so a run cannot be credited with the work it rejected.",
      "properties": {
        "committed": {
          "default": 0,
          "title": "Committed",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "title": "Rejected",
          "type": "integer"
        }
      },
      "title": "RefinementCounts",
      "type": "object"
    },
    "RefinementKind": {
      "enum": [
        "add_edge",
        "retarget_edge",
        "confirm_edge",
        "resolve_ambiguous",
        "relabel_cluster",
        "move_node",
        "annotate_node",
        "unresolvable"
      ],
      "title": "RefinementKind",
      "type": "string"
    },
    "RefinementPayload": {
      "description": "What a refinement carries beyond its target: a label, an annotation, the candidate it\nchose, the reason code it retired a pair under, and the call form it saw.",
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation"
        },
        "call_form": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallForm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "title": "RefinementPayload",
      "type": "object"
    },
    "RefinementRowPayload": {
      "description": "One refinement as every surface shows it: the target flattened, the proposal's own values\nbeside it, the anchors by node id.\n\n``payload`` is carried whole rather than flattened further: a ``pending`` row is one a human\nhas to judge, and the label, annotation, candidate or reason code is what there is to judge.",
      "properties": {
        "anchors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Anchors",
          "type": "array"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "default": 0.0,
          "title": "Created At",
          "type": "number"
        },
        "drifted": {
          "default": false,
          "title": "Drifted",
          "type": "boolean"
        },
        "dst": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst"
        },
        "edge_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from_dst": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Dst"
        },
        "kind": {
          "$ref": "#/$defs/RefinementKind"
        },
        "members": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "noop_builds": {
          "default": 0,
          "title": "Noop Builds",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/RefinementPayload",
          "default": {
            "annotation": null,
            "call_form": null,
            "candidate": null,
            "label": null,
            "reason_code": null
          }
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "refinement_id": {
          "title": "Refinement Id",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "src": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src"
        },
        "status": {
          "$ref": "#/$defs/RefinementStatus"
        },
        "status_at": {
          "default": 0.0,
          "title": "Status At",
          "type": "number"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "refinement_id",
        "run_id",
        "kind",
        "tier",
        "status"
      ],
      "title": "RefinementRowPayload",
      "type": "object"
    },
    "RefinementStatus": {
      "enum": [
        "pending",
        "active",
        "stale",
        "redundant",
        "reverted",
        "pinned",
        "superseded",
        "rejected"
      ],
      "title": "RefinementStatus",
      "type": "string"
    },
    "RunRowPayload": {
      "description": "One run as the log shows it: who made it, against which checkout, and what it cost.\n\n``cost_estimated`` travels with ``cost_usd`` because a runner that reports no price has one\nmodelled for it, and a log that showed only the number would present it as measured.",
      "properties": {
        "agent_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "client": {
          "$ref": "#/$defs/ClientKind"
        },
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "cost_estimated": {
          "default": false,
          "title": "Cost Estimated",
          "type": "boolean"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "num_turns": {
          "default": 0,
          "title": "Num Turns",
          "type": "integer"
        },
        "producer": {
          "$ref": "#/$defs/ProducerKind"
        },
        "prompt_chars": {
          "default": 0,
          "title": "Prompt Chars",
          "type": "integer"
        },
        "refinements": {
          "$ref": "#/$defs/RefinementCounts",
          "default": {
            "committed": 0,
            "rejected": 0
          }
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "runner": {
          "$ref": "#/$defs/RunnerKind"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "started_at": {
          "default": 0.0,
          "title": "Started At",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "system_prompt_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt Sha"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "trigger_detail": {
          "$ref": "#/$defs/TriggerDetailPayload",
          "default": {
            "assessment": null,
            "file_count": 0,
            "files": []
          }
        },
        "trigger_kind": {
          "$ref": "#/$defs/TriggerKind"
        }
      },
      "required": [
        "run_id",
        "status",
        "producer",
        "client",
        "runner",
        "trigger_kind"
      ],
      "title": "RunRowPayload",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "aborted",
        "rejected",
        "skipped"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RunnerKind": {
      "enum": [
        "claude",
        "codex",
        "fake",
        "none"
      ],
      "title": "RunnerKind",
      "type": "string"
    },
    "Tier": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Tier",
      "type": "string"
    },
    "TriggerDetailPayload": {
      "description": "What a run's trigger carried: the paths it named, and the gate decision behind it.\n\n``files`` is capped for the same reason the counts replace the id tuples: a Stop path set can\nname hundreds of paths and a fifty row page would carry all of them.",
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssessmentPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "file_count": {
          "default": 0,
          "title": "File Count",
          "type": "integer"
        },
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "title": "TriggerDetailPayload",
      "type": "object"
    },
    "TriggerKind": {
      "enum": [
        "session_start",
        "edit",
        "suspect",
        "manual",
        "tune",
        "verify",
        "eval",
        "retire"
      ],
      "title": "TriggerKind",
      "type": "string"
    }
  },
  "description": "One page of the run stream. `LogReport` is `graph log`'s own shape, reused not copied.",
  "properties": {
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "log": {
      "$ref": "#/$defs/LogReport"
    },
    "repo": {
      "title": "Repo",
      "type": "string"
    }
  },
  "required": [
    "repo",
    "identity"
  ],
  "title": "RunsView",
  "type": "object"
}
