{
  "$defs": {
    "BudgetPayload": {
      "description": "One day's budget as the page's meter draws it, derived numbers included (recon Q12).",
      "properties": {
        "evaluated": {
          "default": false,
          "title": "Evaluated",
          "type": "boolean"
        },
        "exhausted": {
          "default": false,
          "title": "Exhausted",
          "type": "boolean"
        },
        "low": {
          "default": false,
          "title": "Low",
          "type": "boolean"
        },
        "low_budget_fraction": {
          "default": 0.0,
          "title": "Low Budget Fraction",
          "type": "number"
        },
        "max_cost_usd_per_day": {
          "default": 0.0,
          "title": "Max Cost Usd Per Day",
          "type": "number"
        },
        "max_runs_per_day": {
          "default": 0,
          "title": "Max Runs Per Day",
          "type": "integer"
        },
        "priced": {
          "default": true,
          "title": "Priced",
          "type": "boolean"
        },
        "remaining_fraction": {
          "default": 0.0,
          "title": "Remaining Fraction",
          "type": "number"
        },
        "runs": {
          "default": 0,
          "title": "Runs",
          "type": "integer"
        },
        "spent_usd": {
          "default": 0.0,
          "title": "Spent Usd",
          "type": "number"
        }
      },
      "title": "BudgetPayload",
      "type": "object"
    },
    "RateLimitPayload": {
      "description": "The rate limit meter: the share the observer may take, and whether it is holding.",
      "properties": {
        "max_utilization": {
          "default": 0.0,
          "title": "Max Utilization",
          "type": "number"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        },
        "resumes_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resumes At"
        }
      },
      "title": "RateLimitPayload",
      "type": "object"
    },
    "RepoPayload": {
      "description": "One repo in the switcher, with the meters that belong to it.",
      "properties": {
        "attached": {
          "default": false,
          "title": "Attached",
          "type": "boolean"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/RateLimitPayload"
        },
        "queued": {
          "default": false,
          "title": "Queued",
          "type": "boolean"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "repo_dir_key": {
          "title": "Repo Dir Key",
          "type": "string"
        },
        "sessions": {
          "default": 0,
          "title": "Sessions",
          "type": "integer"
        },
        "state": {
          "default": "",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "identity",
        "repo_dir_key"
      ],
      "title": "RepoPayload",
      "type": "object"
    }
  },
  "description": "The repo switcher's list.",
  "properties": {
    "repos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RepoPayload"
      },
      "title": "Repos",
      "type": "array"
    }
  },
  "title": "ReposPayload",
  "type": "object"
}
