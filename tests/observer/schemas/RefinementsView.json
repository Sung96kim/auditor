{
  "$defs": {
    "CallForm": {
      "description": "How a name was called at the site the resolver could not place: a bare ``name()``, a\ndirect ``self``/``cls`` receiver, or any other attribute receiver.",
      "enum": [
        "bare",
        "self",
        "attr"
      ],
      "title": "CallForm",
      "type": "string"
    },
    "EdgeKind": {
      "enum": [
        "contains",
        "calls",
        "imports",
        "inherits",
        "overrides",
        "callback_arg",
        "registered_in",
        "references_type",
        "name_similar",
        "usage_similar"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "RefinementKind": {
      "enum": [
        "add_edge",
        "retarget_edge",
        "confirm_edge",
        "resolve_ambiguous",
        "relabel_cluster",
        "move_node",
        "annotate_node",
        "unresolvable"
      ],
      "title": "RefinementKind",
      "type": "string"
    },
    "RefinementPayload": {
      "description": "What a refinement carries beyond its target: a label, an annotation, the candidate it\nchose, the reason code it retired a pair under, and the call form it saw.",
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation"
        },
        "call_form": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallForm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "title": "RefinementPayload",
      "type": "object"
    },
    "RefinementRowPayload": {
      "description": "One refinement as every surface shows it: the target flattened, the proposal's own values\nbeside it, the anchors by node id.\n\n``payload`` is carried whole rather than flattened further: a ``pending`` row is one a human\nhas to judge, and the label, annotation, candidate or reason code is what there is to judge.",
      "properties": {
        "anchors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Anchors",
          "type": "array"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "default": 0.0,
          "title": "Created At",
          "type": "number"
        },
        "drifted": {
          "default": false,
          "title": "Drifted",
          "type": "boolean"
        },
        "dst": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst"
        },
        "edge_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from_dst": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Dst"
        },
        "kind": {
          "$ref": "#/$defs/RefinementKind"
        },
        "members": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "noop_builds": {
          "default": 0,
          "title": "Noop Builds",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/RefinementPayload",
          "default": {
            "annotation": null,
            "call_form": null,
            "candidate": null,
            "label": null,
            "reason_code": null
          }
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "refinement_id": {
          "title": "Refinement Id",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "src": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src"
        },
        "status": {
          "$ref": "#/$defs/RefinementStatus"
        },
        "status_at": {
          "default": 0.0,
          "title": "Status At",
          "type": "number"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "refinement_id",
        "run_id",
        "kind",
        "tier",
        "status"
      ],
      "title": "RefinementRowPayload",
      "type": "object"
    },
    "RefinementStatus": {
      "enum": [
        "pending",
        "active",
        "stale",
        "redundant",
        "reverted",
        "pinned",
        "superseded",
        "rejected"
      ],
      "title": "RefinementStatus",
      "type": "string"
    },
    "RefinementsReport": {
      "description": "``auditr graph refinements list`` and ``graph_refinements``: one page, newest first.\n\n``filtered`` is why an empty list is empty, and ``refinement_count`` is how many rows the same\nfilters match, so a page at the cap cannot be read as the whole list.",
      "properties": {
        "filtered": {
          "default": false,
          "title": "Filtered",
          "type": "boolean"
        },
        "refinement_count": {
          "default": 0,
          "title": "Refinement Count",
          "type": "integer"
        },
        "rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RefinementRowPayload"
          },
          "title": "Rows",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "RefinementsReport",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "description": "The refinement list by status, including `pending`, `redundant` and `drifted`.",
  "properties": {
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "refinements": {
      "$ref": "#/$defs/RefinementsReport"
    },
    "repo": {
      "title": "Repo",
      "type": "string"
    }
  },
  "required": [
    "repo",
    "identity"
  ],
  "title": "RefinementsView",
  "type": "object"
}
